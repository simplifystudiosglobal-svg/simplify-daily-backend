# PORT: only used by the local `npm run dev` server. Does not apply on Vercel —
# serverless functions don't bind a port.
PORT=3001

# ADMIN_PASSCODE: Passcode for verifying admin actions in the news desk.
# Required — there is no built-in fallback.
ADMIN_PASSCODE="choose-a-strong-passcode"

# SERVER_SECRET: Signs admin session tokens. Without it, a random value is generated
# per-process. On a normal always-on server that only breaks sessions across a restart —
# but on Vercel, set this for real: separate serverless invocations can get separate
# processes, so an unset SERVER_SECRET can make admin login work inconsistently.
# Generate one with `openssl rand -hex 32`.
SERVER_SECRET="MY_SERVER_SECRET"

# FRONTEND_ORIGIN: comma-separated list of origins allowed to call this API (CORS) and
# used as the base URL for the /rss.xml feed links, e.g.:
# FRONTEND_ORIGIN="https://simplify-daily.vercel.app,http://localhost:5173"
FRONTEND_ORIGIN=""
