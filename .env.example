# PORT: most hosts (Render, Railway, etc.) inject this automatically. Only set it
# yourself for local runs where you want something other than the 3001 default.
PORT=3001

# ADMIN_PASSCODE: Passcode for verifying admin actions in the news desk.
# Required — there is no built-in fallback.
ADMIN_PASSCODE="choose-a-strong-passcode"

# SERVER_SECRET: Signs admin session tokens. Required for admin sessions to survive a
# server restart — without it, a random value is generated each boot. Set this to a
# long random string on your host (e.g. `openssl rand -hex 32`).
SERVER_SECRET="MY_SERVER_SECRET"

# FRONTEND_ORIGIN: comma-separated list of origins allowed to call this API (CORS) and
# used as the base URL for the /rss.xml feed links, e.g.:
# FRONTEND_ORIGIN="https://simplify-daily.vercel.app,http://localhost:5173"
FRONTEND_ORIGIN=""
